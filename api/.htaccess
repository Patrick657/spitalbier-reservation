# Defense in depth: config.local.php only ever defines a PHP array (no
# output), so a direct request can't leak secrets — but block it anyway.
<FilesMatch "^config\.local\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
